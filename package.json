{
  "name": "bookshelf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "探索、收藏、管理你的個人書單 — React + TypeScript 作品集專案，串接 Google Books API",
  "author": "rHyThM3294",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rHyThM3294/bookshelf.git"
  },
  "homepage": "https://rHyThM3294.github.io/bookshelf/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts",
    "lighthouse": "lhci autorun",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^24.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.0.5"
  }
}
